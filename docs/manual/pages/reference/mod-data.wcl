// Part III — Reference. Declared mode: reference.
page ref_mod_data {
  sites = [:manual]
  title = "data module"

  chapter_header "data module" {
    kicker       = "Reference · reference"
    reading_time = "1 min read"
    updated      = "2026-09-02"
    version      = "config-weave 0.1.0"
  }

  p <<'PROSE'
`use data` parses and serializes INI files over the [Value type](ref_value).
JSON, TOML and XML live in their own modules: [json](ref_mod_json),
[toml](ref_mod_toml) and [xml](ref_mod_xml). Both functions return
`Result[…, string]`. The parser accepts `key=value` lines and `[section]`
headers, and rejects any other non-blank line with an error that names the
line number.
PROSE

  h2 "ini_parse"

  code rust {
    source = <<'SRC'
data::ini_parse(text: string) -> Result[Value, string]
SRC
  }

  p "Parses INI text into a map of sections. Each section is a map of its keys. Keys that appear before the first section header are placed under the empty-string section, which is dropped when it is empty."

  h2 "ini_serialize"

  code rust {
    source = <<'SRC'
data::ini_serialize(sections: Value) -> Result[string, string]
SRC
  }

  p "Serializes a map of sections to INI text. The value must be a map whose entries are maps; anything else is an error."

  code rust {
    source = <<'SRC'
use data
use fs

let cfg = data::ini_parse(fs::read("/etc/app/app.ini")?)?
let server = cfg.get("server")   // Option[Value], a map of the section's keys
SRC
  }
}
