// Part III — Reference. Declared mode: reference.
page ref_mod_toml {
  sites = [:manual]
  title = "toml module"

  chapter_header "toml module" {
    kicker       = "Reference · reference"
    reading_time = "1 min read"
    updated      = "2026-09-02"
    version      = "config-weave 0.1.0"
  }

  p <<'PROSE'
`use toml` parses and serializes TOML over the [Value type](ref_value).
config-weave registers it from wscript-std. Every function returns
`Result[…, string]`. Serialization fails when the top-level value is not a
map, and when a `Value::Null` appears anywhere, because TOML has no null.
INI files are handled by the [data module](ref_mod_data).
PROSE

  h2 "parse"

  code rust {
    source = <<'SRC'
toml::parse(text: string) -> Result[Value, string]
SRC
  }

  p "Parses TOML text into a `Value`. Tables become maps and arrays become lists. Date and time values become strings."

  h2 "to_string and to_string_pretty"

  code rust {
    source = <<'SRC'
toml::to_string(value: Value) -> Result[string, string]
toml::to_string_pretty(value: Value) -> Result[string, string]
SRC
  }

  p "Serializes a map `Value` as TOML, in compact or in expanded form."

  code rust {
    source = <<'SRC'
use fs
use toml

let cfg = toml::parse(fs::read("/etc/app/config.toml")?)?
fs::write("/etc/app/config.toml", toml::to_string_pretty(cfg)?)?
SRC
  }
}
