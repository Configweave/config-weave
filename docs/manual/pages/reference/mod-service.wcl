// Part III — Reference. Declared mode: reference.
page ref_mod_service {
  sites = [:manual]
  title = "service module (Windows)"

  chapter_header "service module (Windows)" {
    kicker       = "Reference · reference"
    reading_time = "1 min read"
    updated      = "2026-09-02"
    version      = "config-weave 0.1.0"
  }

  p <<'PROSE'
`use service` manages Windows services through the Service Control Manager.
It is Windows-only in this version: manage Linux services by running
`systemctl` through the [shell module](ref_mod_shell). The module is
registered on every platform so a playbook compiles and validates
identically everywhere; on Linux and macOS every call returns a runtime
error. Every function takes the service name and returns
`Result[…, string]`.
PROSE

  h2 "status"

  code rust {
    source = <<'SRC'
service::status(name: string) -> Result[string, string]
SRC
  }

  p "The current state of a service: `running`, `stopped`, `start_pending`, `stop_pending`, `paused`, `pause_pending` or `continue_pending`. A state the module does not recognise is reported as `unknown`."

  h2 "start and stop"

  code rust {
    source = <<'SRC'
service::start(name: string) -> Result[unit, string]
service::stop(name: string) -> Result[unit, string]
SRC
  }

  p "Starts or stops a service. Each is a no-op when the service is already in the target state."

  h2 "set_startup and startup"

  code rust {
    source = <<'SRC'
service::set_startup(name: string, mode: string) -> Result[unit, string]
service::startup(name: string) -> Result[string, string]
SRC
  }

  p "`set_startup` sets the startup type to `automatic`, `manual` or `disabled`. `startup` reads it back; a type outside those three is reported as `other`."

  code rust {
    source = <<'SRC'
use service
use value

fn apply(props: Value) -> Result[ApplyResult, string] {
    service::set_startup("Spooler", "disabled")?
    service::stop("Spooler")?
    Ok(ApplyResult::Success)
}
SRC
  }
}
