// Part III — Reference. Declared mode: reference.
page ref_mod_json {
  sites = [:manual]
  title = "json module"

  chapter_header "json module" {
    kicker       = "Reference · reference"
    reading_time = "1 min read"
    updated      = "2026-09-02"
    version      = "config-weave 0.1.0"
  }

  p <<'PROSE'
`use json` parses and serializes JSON over the [Value type](ref_value).
config-weave registers it from wscript-std. Only `parse` can fail; it
returns `Result[Value, string]`. Serialization sorts map keys, so the same
value always produces the same text and a rewritten file only changes when
its content does.
PROSE

  h2 "parse"

  code rust {
    source = <<'SRC'
json::parse(text: string) -> Result[Value, string]
SRC
  }

  p "Parses JSON text into a `Value`. Objects become maps, arrays become lists and `null` becomes `Value::Null`."

  h2 "to_string and to_string_pretty"

  code rust {
    source = <<'SRC'
json::to_string(value: Value) -> string
json::to_string_pretty(value: Value) -> string
SRC
  }

  p "Serializes a `Value` as compact JSON, or as indented JSON. Keys are emitted in sorted order."

  code rust {
    source = <<'SRC'
use fs
use json

let cfg = json::parse(fs::read("/etc/app/config.json")?)?
let enabled = match cfg.get("enabled") {
    Some(v) => v.as_bool().unwrap_or(false),
    None => false,
}
SRC
  }
}
