entity wscript_lang {
  name     = "wscript"
  kind     = :software
  summary  = "The statically typed, Rust-flavored scripting language resources, gatherers and verify scripts are written in."
  related  = [wscript_overview, resource, gatherer, host_api]
  audience = :both
  body {
    p "wscript is the scripting language config-weave embeds for resources, gatherers and verify scripts. Compiled against the config-weave host API; scripts may import shared helpers from `lib/`. Its features are documented as the `wscript:` concepts."
    table {
      header = ["Field", "Value"]
      rows = [
        ["Flavour",   "Rust minus borrow checker, lifetimes, generics"],
        ["Typing",    "Static, compile-time checked"],
        ["Scripts",   "Multi-file — `use` imports helpers from `lib/` (see [Shared script helpers](concept_script_imports))"],
        ["Compiled against", "the config-weave host API (weave.wscripti)"],
        ["Reference", "the `wscript` wskill (~/dev/wscript/docs/wskills/wscript/)"],
      ]
    }
  }
}
