fact wscript_excluded_v1 {
  title    = "Excluded from wscript v1"
  related  = [wscript_overview, wscript_loops, wscript_traits_operators]
  audience = :both
  body {
    p "Deliberately absent in wscript v1:"
    p "Borrow checker, `&`/`&mut`, lifetimes, exceptions, async, threads, implicit conversions, truthiness, and bitwise operators."
    p "Shipped since v1, so no longer absent: script-to-script imports, string interpolation in every string literal, compound assignment (`+=`), associated functions, generic functions (not host-callable), and unit families on numeric types."
  }
}
