procedure encrypt_secrets {
  title    = "Encrypt a value in a playbook"
  purpose  = "Put a password, token or key into playbook.wcl without committing it in the clear, and run against it."
  preconditions = ["A playbook you can edit.", "A password you can supply through the environment, stdin or a file."]
  related  = [encrypted_values, variables, playbook]
  audience = :both

  step author { n = 1
    title = "Write the value as secret(\"…\")"
    body screen {
      code "wcl" { source = <<'WCL'
vars {
  db_password = secret("hunter2")
}
WCL
      }
      callout "Anywhere an expression goes" { class = ["info"]  body = "`secret()` is a builtin, not a block: it is equally legal in a step's `properties`, a gather's `params` or a `condition`. Its argument must be a plain string literal — a variable or an interpolated `$\"…\"` cannot be encrypted in place." }
    }
    body steps { p "Write the plaintext into the playbook. It is a validation error at this point: `check`, `apply` and `validate` all refuse to run until it is encrypted." }
  }

  step encrypt { n = 2
    title = "Encrypt in place"
    body screen {
      code "console" { source = <<'SH'
$ export CONFIG_WEAVE_PASSWORD='correct horse battery staple'
$ config-weave secrets encrypt ./my-playbook
./my-playbook/playbook.wcl: encrypted 1 secret(s)
SH
      }
      callout "Only the call changes" { class = ["info"]  body = "The rewrite splices the one call's byte range and re-parses before writing. Comments, indentation and formatting elsewhere are untouched, so the diff is one line." }
    }
    body steps { p "Run `config-weave secrets encrypt <dir>`. Adding a second secret later needs the *same* password — the command decrypts every existing value first, and points at `secrets rekey` if the password does not match." }
  }

  step run { n = 3
    title = "Check and apply with the password"
    body screen {
      code "console" { source = <<'SH'
$ config-weave check ./my-playbook baseline          # $CONFIG_WEAVE_PASSWORD
$ config-weave apply ./my-playbook baseline --password-stdin < pw.txt
$ config-weave apply ./my-playbook baseline --password-file /run/secrets/pw
SH
      }
      callout "Verified up front" { class = ["info"]  body = "The run decrypts every value before executing, not when the evaluator happens to reach one — so a wrong password fails immediately (exit 2) even if no step references the secret." }
    }
    body steps { p "Supply the password through exactly one of `$CONFIG_WEAVE_PASSWORD`, `--password-stdin` or `--password-file PATH`. Giving more than one is an error rather than a silent pick." }
  }

  step maintain { n = 4
    title = "Edit or re-key later"
    body screen {
      code "console" { source = <<'SH'
$ config-weave secrets decrypt ./my-playbook       # back to plaintext, to edit
$ config-weave secrets encrypt ./my-playbook       # re-encrypt

$ CONFIG_WEAVE_NEW_PASSWORD='a new one' \
    config-weave secrets rekey ./my-playbook       # change the password
SH
      }
      callout "decrypt writes plaintext to disk" { class = ["warning"]  body = "`secrets decrypt` puts the real values back in the file so you can edit them. Re-encrypt before committing." }
    }
    body steps { p "`rekey` decrypts with the old password, mints a fresh salt and re-encrypts everything under the new one — sweeping up any still-plaintext calls in the same pass. The new password comes from `--new-password-file` or `$CONFIG_WEAVE_NEW_PASSWORD`." }
  }

  author -> encrypt
  encrypt -> run
  run -> maintain

  verification = "`grep` the playbook for the plaintext finds nothing, `config-weave validate` passes, and `check` with the password reports the play normally."
}
