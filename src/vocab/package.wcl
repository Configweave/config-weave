// Config Weave package vocabulary (`package.wcl` schema).
// Served as the system import <weave/package.wcl>; the engine appends the
// import automatically when opening a package.

@document
type WeavePackageDoc {
  @child("package") package: WeavePackage
}

@block("package")
type WeavePackage {
  @inline(0) name: utf8
  description: utf8
  @children("gatherer") gatherers: list<WeaveGathererDecl>
  @children("resource") resources: list<WeaveResourceDecl>
  @children("composite") composites: list<WeaveCompositeDecl>
  @children("test") tests: list<WeaveTestDecl>
  @children("scenario") scenarios: list<WeaveScenarioDecl>
}

// A named, parameterised block of steps, invoked from a step exactly like a
// resource — the unit of reuse between "one resource" and "copy-paste five
// steps". Composites and resources share one namespace, so a package may not
// declare both under the same name.
//
// Each declared `arg` binds as a variable inside the body, two ways: bare
// (`body`) and under the `args` map (`args.body`). Prefer `args.` — a
// property field shadows a bare outer variable of the same name, so the
// pass-through `properties { path = path }` is a self-reference cycle while
// `properties { path = args.path }` always works.
//
// A body sees *only* its own arguments: never the playbook's gatherer
// results, vars or `--var` overrides. A composite is a function, not a
// macro; a fact it needs is passed in as a property. That is what lets one
// be promoted from a playbook to a package unchanged.
@block("composite")
type WeaveCompositeDecl {
  @inline(0) name: utf8
  description: utf8
  @children("arg") declared_args: list<WeaveArgDecl>
  @children("step") steps: list<WeaveStepDecl>
}

// One declared argument of a composite. Same shape as a resource's
// `param`, under its own block kind so the body can read the values as
// `args.name`.
@block("arg")
type WeaveArgDecl {
  @inline(0) name: utf8
  description: utf8
  type: utf8
  @default(false) required: bool
  @schemaless default: utf8?
  @children("symbol") symbols: list<WeaveSymbolDecl>
}

// A wscript-scripted, multi-stage test over a declared vmlab lab. `lab` points
// at a directory holding a vmlab.wcl (the full vmlab feature set: segments,
// DNS, static IPs, depends_on, …); `script` is the driver (fn run(lab) -> bool)
// that brings VMs up by name, applies config-weave, reboots, and asserts —
// for flows the three-run `test` protocol can't express (reboot-and-continue,
// multi-machine topologies like a DC plus a member server).
@block("scenario")
type WeaveScenarioDecl {
  @inline(0) name: utf8
  description: utf8
  lab: utf8
  script: utf8
}

@block("gatherer")
type WeaveGathererDecl {
  @inline(0) name: utf8
  description: utf8
  script: utf8
  @children("param") params: list<WeaveParamDecl>
  @children("returns") returns: list<WeaveReturnDecl>
}

// One key of the value a gatherer returns. Mostly documentation metadata
// (the docs render a Returns table): the engine does not check that a
// gathered map carries these keys, or only these, because a gathered map
// may legitimately hold dynamic ones.
//
// A key declared `type = "symbol"` is the exception — it is *typed*. Its
// value binds into the variable space as a WCL symbol, so a playbook
// compares it as `init.init == :systemd`, and enumerating `symbol` blocks
// closes the set exactly as it does for a parameter.
@block("returns")
type WeaveReturnDecl {
  @inline(0) name: utf8
  description: utf8
  type: utf8
  @children("symbol") symbols: list<WeaveSymbolDecl>
}

@block("resource")
type WeaveResourceDecl {
  @inline(0) name: utf8
  description: utf8
  script: utf8
  @default("parallel") concurrency: utf8
  @children("param") params: list<WeaveParamDecl>
}

// One declared parameter: coarse type, requiredness, default, description.
@block("param")
type WeaveParamDecl {
  @inline(0) name: utf8
  description: utf8
  type: utf8
  @default(false) required: bool
  @schemaless default: utf8?
  @children("symbol") symbols: list<WeaveSymbolDecl>
}

// One legal value of a `type = "symbol"` parameter or returns key.
// Declaring any narrows it to exactly this set — validation rejects
// anything else and the generated docs list the values with their
// descriptions. Declaring none leaves it unconstrained (any token is
// accepted).
//
// Name the symbol in its WCL-spellable form (`"on_demand"`, not
// `"on-demand"`): the lexer stops a `:symbol` at [A-Za-z0-9_].
@block("symbol")
type WeaveSymbolDecl {
  @inline(0) name: utf8
  description: utf8
}

// An isolated convergence test for this package, run by `config-weave
// test` inside a disposable vmlab instance. Declare exactly one of:
//   image    — an OCI image ref ("debian:12"), run as a vmlab container;
//              linux only, seconds to start, the default choice.
//   template — a vmlab template ref ("x86_64/ubuntu-24.04"), run as a
//              full VM; linux or windows, and the only option for
//              anything needing a real init, kernel or reboot.
@block("test")
type WeaveTestDecl {
  @inline(0) name: utf8
  description: utf8
  image: utf8?
  template: utf8?
  // Guest RAM for the instance, as a WCL byte size ("4GiB", "512MiB").
  // Omitted = the vmlab default (256MiB for a container, the template's
  // own sizing for a VM). Guest memory is allocated on demand, so raising
  // it for a heavy image costs nothing for the light ones. Grouped tests
  // share an instance and so must agree on it.
  memory: utf8?
  // Tests sharing a non-empty `group` (within a package) run sequentially
  // inside one shared instance instead of each provisioning its own —
  // amortizing container start / VM boot. They must agree on `image` /
  // `template`, and they share the instance's OS state (no reset between
  // them), so only group tests that target distinct state.
  group: utf8?
  setup: utf8?
  verify: utf8?
  @children("step") steps: list<WeaveStepDecl>
  @children("gather") gathers: list<WeaveTestGather>
}

// A resource invocation, used by both a `test` and a `composite` body.
// Block kinds are one-per-namespace in WCL, so the two share a schema and
// the loader rejects the fields that belong only to the other: `expect` is
// a test's assertion, `concurrency` a composite step's tightening.
@block("step")
type WeaveStepDecl {
  @inline(0) name: utf8
  description: utf8
  resource: utf8
  @default("converge") expect: utf8
  @schemaless condition: bool?
  requires: list<utf8>?
  concurrency: utf8?
  @child("properties") properties: WeaveProperties?
}

// Free-form property map validated against the resource's declared params.
@schemaless
@block("properties")
type WeaveProperties {}

// A gatherer invocation under test with equality expectations.
@block("gather")
type WeaveTestGather {
  @inline(0) name: utf8
  description: utf8
  from: utf8
  @child("params") params: WeaveTestParams?
  @child("expect") expect: WeaveTestExpect?
}

// Free-form parameter map validated against the gatherer's declared params.
@schemaless
@block("params")
type WeaveTestParams {}

// Top-level key equality assertions over the gathered value.
@schemaless
@block("expect")
type WeaveTestExpect {}
